// Cloudflare Workers configuration: publish the built site in dist/ as static
// assets. There is no Worker script; everything is prerendered at build time.
// Build command: npm run build · Deploy command: npx wrangler deploy
{
  "name": "vvf-web",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
}
