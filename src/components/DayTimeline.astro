---
import type { Locale } from '@/i18n';
import { localePath } from '@/i18n';
import { getMessages } from '@/i18n/messages';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  /** On the Gurukul-life page the heading comes from that page's copy. */
  kicker?: string;
  title?: string;
  lede?: string;
  showLink?: boolean;
}
const t = getMessages(Astro.props.locale);
const d = t.home.day;
const { locale, kicker = d.kicker, title = d.h2, lede = d.lede, showLink = true } = Astro.props;
---

<section id="day" class="scroll-mt-24 bg-paper-2 py-16 lg:py-24">
  <div class="page">
    <SectionHead kicker={kicker} title={title} lede={lede} />

    <div class="reveal mt-10 grid gap-8 lg:grid-cols-[1fr_1.4fr] lg:gap-14" data-tabs>
      <div
        role="tablist"
        aria-label={d.tablistLabel}
        aria-orientation="vertical"
        class="timeline relative border-l-2 border-paper-3 pl-6"
      >
        {d.moments.map((m, i) => (
          <button
            type="button"
            role="tab"
            id={`day-tab-${i}`}
            aria-controls={`day-panel-${i}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="moment"
          >
            <span class="dot" aria-hidden="true" />
            <span class="t-small block text-ink-2">{m.time}</span>
            <span class="block font-[family-name:var(--font-display)] text-lg leading-snug">
              {m.title}
            </span>
          </button>
        ))}
      </div>

      <div class="min-w-0">
        {d.moments.map((m, i) => (
          <div
            role="tabpanel"
            id={`day-panel-${i}`}
            aria-labelledby={`day-tab-${i}`}
            tabindex="0"
            class="panel rounded-md border border-line bg-paper p-6 md:p-10"
          >
            <p class="t-eyebrow text-kesari-deep">
              {m.time} · {m.kicker}
            </p>
            <h3 class="t-h2 mt-3 text-ink">{m.title}</h3>
            <p class="t-lede mt-4 text-ink-2">{m.body}</p>
            <p class="t-deva mt-8 border-t border-line pt-5 text-xl text-kesari-deep" lang="sa">
              {m.sa}
            </p>
          </div>
        ))}
      </div>
    </div>

    {showLink && (
      <div class="reveal mt-8">
        <a
          href={localePath(locale, '/life/')}
          class="nl inline-flex items-center gap-2 text-kesari-deep"
        >
          {d.cta}
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
    )}
  </div>
</section>

<style>
  .moment {
    position: relative;
    display: block;
    width: 100%;
    text-align: left;
    padding: 0.75rem 1rem 0.75rem 0.75rem;
    margin: 0.125rem 0;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-ink-2);
    cursor: pointer;
    transition:
      background-color 0.25s var(--ease-rise),
      color 0.25s var(--ease-rise);
  }
  .moment:hover {
    background: rgba(250, 246, 238, 0.7);
    color: var(--color-ink);
  }
  .moment[aria-selected='true'] {
    background: var(--color-paper);
    color: var(--color-ink);
  }
  .dot {
    position: absolute;
    left: calc(-1.5rem - 7px);
    top: 1.25rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-paper-3);
    transition:
      background-color 0.25s var(--ease-rise),
      box-shadow 0.25s var(--ease-rise);
  }
  .moment[aria-selected='true'] .dot {
    background: var(--color-kesari);
    box-shadow: 0 0 0 4px rgba(181, 85, 26, 0.18);
  }
  .panel[hidden] {
    display: none;
  }
  .panel:not([hidden]) {
    animation: rise 0.5s var(--ease-rise) both;
  }
</style>
