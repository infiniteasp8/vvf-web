---
import type { Locale } from '@/i18n';
import { getMessages } from '@/i18n/messages';
import SectionHead from './SectionHead.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const k = getMessages(locale).home.keeps;
---

<section class="page py-16 lg:py-24">
  <SectionHead kicker={k.kicker} title={k.h2} lede={k.lede} />
  <ol class="mt-12 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
    {k.items.map((item, i) => (
      <li class={`keep reveal border-t border-line pt-6 ${i ? `d${i}` : ''}`}>
        <span class="num" aria-hidden="true">
          {item.num}
        </span>
        <h3 class="t-h3 mt-4 text-ink">{item.title}</h3>
        <p class="mt-3 text-ink-2">{item.body}</p>
      </li>
    ))}
  </ol>
</section>
