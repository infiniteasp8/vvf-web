---
import type { Locale } from '@/i18n';
import { getMessages } from '@/i18n/messages';
import { Image } from 'astro:assets';
import emblem from '@/assets/brand/emblem.png';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getMessages(locale);
const a = t.common.arrival;
---

<div class="intro" data-intro>
  <svg
    viewBox="0 0 320 200"
    width="280"
    height="175"
    class="i-art"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <radialGradient id="intro-glow" cx="0.5" cy="0.5" r="0.5">
        <stop offset="0" stop-color="#F3C98B" stop-opacity="0.8"></stop>
        <stop offset="1" stop-color="#F3C98B" stop-opacity="0"></stop>
      </radialGradient>
      <clipPath id="intro-clip">
        <rect x="0" y="0" width="320" height="120"></rect>
      </clipPath>
      <linearGradient id="intro-flame" x1="0" y1="1" x2="0" y2="0">
        <stop offset="0" stop-color="#B5551A"></stop>
        <stop offset="0.5" stop-color="#F3C98B"></stop>
        <stop offset="1" stop-color="#FAF6EE"></stop>
      </linearGradient>
    </defs>
    <g clip-path="url(#intro-clip)">
      <g class="i-glow">
        <circle cx="160" cy="120" r="100" fill="url(#intro-glow)"></circle>
      </g>
      <g class="i-sun">
        <circle cx="160" cy="120" r="46" fill="#B5551A"></circle>
      </g>
    </g>
    <rect class="i-horizon" x="20" y="119" width="280" height="2" fill="#1F1A17"></rect>
    <g>
      <path d="M140 176c0 10 9 16 20 16s20-6 20-16z" fill="#8F4213"></path>
      <ellipse cx="160" cy="176" rx="20" ry="4" fill="#B5551A"></ellipse>
      <path
        class="i-flame"
        d="M160 146c-7 11-7 20 0 28 7-8 7-17 0-28z"
        fill="url(#intro-flame)"
      ></path>
    </g>
  </svg>

  <p class="t-deva mt-8 text-center text-3xl text-ink md:text-4xl" lang="sa">
    {a.mantra.map((word, i) => (
      <span class="i-word" style={`animation-delay: ${(1.0 + i * 0.09).toFixed(2)}s`}>
        {word}
      </span>
    ))}
  </p>
  <p class="i-iast t-iast mt-3 text-center text-lg text-kesari-deep" lang="sa-Latn">
    {a.iast}
  </p>
  <p class="i-en t-lede mt-2 max-w-md text-center text-ink-2">{a.translation}</p>
  <div class="i-mark mt-8 flex flex-col items-center gap-4">
    <Image
      src={emblem}
      alt=""
      width={72}
      densities={[1, 2]}
      loading="eager"
      decoding="async"
      class="h-16 w-16 rounded-full md:h-18 md:w-18"
    />
    <p class="t-eyebrow text-ink">Ved Vidyalaya Foundation</p>
  </div>

  <button type="button" class="i-skip btn btn-ghost btn-sm absolute top-5 right-5" data-intro-skip>
    {a.skip}
  </button>
</div>
