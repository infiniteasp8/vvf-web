---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '@/i18n';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  items: Array<CollectionEntry<'faq'>>;
}
const { locale, items } = Astro.props;
---

<div class="divide-y divide-line border-y border-line">
  {items.map((entry) => (
    <details class="faq group reveal">
      <summary class="flex items-center justify-between gap-6 py-5 text-left">
        <span class="t-h3 text-ink">{entry.data.question[locale]}</span>
        <span class="pm shrink-0 text-kesari transition-transform duration-300" aria-hidden="true">
          <Icon name="plus" size={22} />
        </span>
      </summary>
      <p class="t-lede max-w-3xl pb-6 text-ink-2">{entry.data.answer[locale]}</p>
    </details>
  ))}
</div>

<style>
  details[open] .pm {
    transform: rotate(45deg);
  }
  details[open] > p {
    animation: rise 0.4s var(--ease-rise) both;
  }
</style>
