---
import type { Locale } from '@/i18n';
import { localePath } from '@/i18n';
import { getMessages } from '@/i18n/messages';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const l = getMessages(locale).home.learning;
const icons = ['lamp', 'book', 'sun', 'leaf'] as const;
---

<section id="learning" class="scroll-mt-24 bg-paper-2 py-16 lg:py-24">
  <div class="page">
    <SectionHead kicker={l.kicker} title={l.h2} />

    <div class="reveal mt-10" data-tabs>
      <div role="tablist" aria-label={l.tablistLabel} class="flex flex-wrap gap-2">
        {l.programs.map((p, i) => (
          <button
            type="button"
            role="tab"
            id={`learning-tab-${i}`}
            aria-controls={`learning-panel-${i}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="tab"
          >
            {p.label}
          </button>
        ))}
      </div>

      {l.programs.map((p, i) => (
        <div
          role="tabpanel"
          id={`learning-panel-${i}`}
          aria-labelledby={`learning-tab-${i}`}
          tabindex="0"
          class="panel mt-6 grid gap-8 rounded-md border border-line bg-paper p-6 md:grid-cols-[1.4fr_1fr] md:p-10"
        >
          <div>
            <p class="t-deva text-xl text-kesari-deep" lang="sa">
              {p.sa}
            </p>
            <h3 class="t-h2 mt-2 text-ink">{p.title}</h3>
            <p class="t-lede mt-4 text-ink-2">{p.body}</p>
            <ul class="mt-6 space-y-2">
              {p.points.map((point) => (
                <li class="flex gap-3 text-ink-2">
                  <span class="t-deva text-kesari" aria-hidden="true">
                    ॥
                  </span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
            <p class="t-small mt-6 text-ink-2">{p.duration}</p>
          </div>
          <div class="frame flex min-h-56 items-end bg-paper-3 p-5" aria-hidden="true">
            <span class="absolute top-5 right-5 text-kesari opacity-80">
              <Icon name={icons[i]} size={40} />
            </span>
            <span class="t-eyebrow text-ink-2">{p.caption}</span>
          </div>
        </div>
      ))}
    </div>

    <div class="reveal mt-8">
      <a
        href={localePath(locale, '/education/')}
        class="nl inline-flex items-center gap-2 text-kesari-deep"
      >
        {l.cta}
        <Icon name="arrow-right" size={16} />
      </a>
    </div>
  </div>
</section>

<style>
  .tab {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.9375rem;
    padding: 0.625rem 1.125rem;
    min-height: 2.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-line-strong);
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
    transition:
      background-color 0.25s var(--ease-rise),
      color 0.25s var(--ease-rise),
      border-color 0.25s var(--ease-rise);
  }
  .tab:hover {
    border-color: var(--color-ink);
  }
  .tab[aria-selected='true'] {
    background: var(--color-ink);
    color: var(--color-paper);
    border-color: var(--color-ink);
  }
  .panel[hidden] {
    display: none;
  }
  .panel:not([hidden]) {
    animation: rise 0.5s var(--ease-rise) both;
  }
</style>
