---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '@/i18n';
import { getMessages, fill } from '@/i18n/messages';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  items: Array<CollectionEntry<'voices'>>;
}
const { locale, items } = Astro.props;
const v = getMessages(locale).home.voices;
---

<section class="page py-16 lg:py-24">
  <SectionHead kicker={v.kicker} title={v.h2} />
  <div
    class="reveal relative mt-10 rounded-md border border-line bg-paper-2 p-6 md:p-12"
    data-carousel
    role="region"
    aria-roledescription="carousel"
    aria-label={v.h2}
  >
    <div class="min-h-[14rem]" data-slides aria-live="polite">
      {items.map((entry, i) => (
        <div
          class="slide"
          data-slide
          role="group"
          aria-roledescription="slide"
          aria-label={fill(v.goTo, { n: i + 1 })}
          hidden={i !== 0}
        >
          <figure>
            <blockquote class="max-w-3xl">
              <span class="t-deva text-3xl text-kesari" aria-hidden="true">
                ॥
              </span>
              <p class="t-h3 mt-2 text-ink">{entry.data.quote[locale]}</p>
            </blockquote>
            <figcaption class="mt-6">
              <span class="t-ui block font-semibold text-ink">{entry.data.who[locale]}</span>
              <span class="t-small block text-ink-2">{entry.data.where[locale]}</span>
            </figcaption>
          </figure>
        </div>
      ))}
    </div>
    <div class="mt-8 flex items-center justify-between gap-4">
      <div class="flex items-center gap-2" role="group">
        {items.map((_, i) => (
          <button
            type="button"
            class="dot"
            data-dot
            aria-label={fill(v.goTo, { n: i + 1 })}
            aria-pressed={i === 0 ? 'true' : 'false'}
          />
        ))}
      </div>
      <div class="flex gap-2">
        <button type="button" class="btn btn-ghost btn-icon" data-prev aria-label={v.prev}>
          <Icon name="arrow-left" size={18} />
        </button>
        <button type="button" class="btn btn-ghost btn-icon" data-next aria-label={v.next}>
          <Icon name="arrow-right" size={18} />
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .slide:not([hidden]) {
    animation: fadein 0.6s ease-out both;
  }
  .dot {
    width: 10px;
    height: 10px;
    padding: 0;
    border: 0;
    border-radius: 5px;
    background: var(--color-paper-3);
    cursor: pointer;
    transition:
      width 0.3s var(--ease-rise),
      background-color 0.3s var(--ease-rise);
  }
  .dot[aria-pressed='true'] {
    width: 28px;
    background: var(--color-kesari);
  }
</style>
