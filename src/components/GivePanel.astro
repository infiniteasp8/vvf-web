---
import type { Locale } from '@/i18n';
import UpiCard from './UpiCard.astro';
import BankCard from './BankCard.astro';

interface Props {
  locale: Locale;
  large?: boolean;
}
const { locale, large = false } = Astro.props;
---

<div class="grid gap-6 lg:grid-cols-2 lg:gap-8">
  <div class="reveal">
    <UpiCard locale={locale} large={large} />
  </div>
  <div class="reveal">
    <BankCard locale={locale} />
  </div>
</div>
