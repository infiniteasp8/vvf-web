---
import type { Locale } from '@/i18n';
import { localePath } from '@/i18n';
import { getMessages } from '@/i18n/messages';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const w = getMessages(locale).home.why;
---

<section id="why" class="page scroll-mt-24 py-16 lg:py-24">
  <SectionHead kicker={w.kicker} title={w.h2} lede={w.lede} />
  <div class="mt-12 grid gap-6 md:grid-cols-3">
    {w.cards.map((card, i) => (
      <article class={`reveal card lift p-6 md:p-7 ${i ? `d${i}` : ''}`}>
        <span class="t-deva text-2xl text-paper-3" aria-hidden="true">
          {['१', '२', '३'][i]}
        </span>
        <h3 class="t-h3 mt-3 text-ink">{card.title}</h3>
        <p class="mt-3 text-ink-2">{card.body}</p>
      </article>
    ))}
  </div>
  <div class="reveal mt-8">
    <a
      href={localePath(locale, '/about/')}
      class="nl inline-flex items-center gap-2 text-kesari-deep"
    >
      {w.cta}
      <Icon name="arrow-right" size={16} />
    </a>
  </div>
</section>
