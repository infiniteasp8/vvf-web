---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { localeStaticPaths, localePath, type Locale } from '@/i18n';
import { getMessages } from '@/i18n/messages';
import { breadcrumbJsonLd, webPageJsonLd } from '@/lib/seo';
import PageHero from '@/components/PageHero.astro';
import SectionHead from '@/components/SectionHead.astro';
import Shloka from '@/components/Shloka.astro';
import Icon from '@/components/Icon.astro';

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = Astro.props.locale as Locale;
const t = getMessages(locale);
const e = t.education;
const siteUrl = Astro.site!;
const path = '/education/';
const icons = ['lamp', 'book', 'sun', 'leaf'] as const;
---

<BaseLayout
  locale={locale}
  title={e.meta.title}
  description={e.meta.description}
  path={path}
  ogImage="/og/education.png"
  current="education"
  jsonLd={[
    webPageJsonLd(siteUrl, locale, { path, title: e.meta.title, description: e.meta.description }),
    breadcrumbJsonLd(siteUrl, locale, [
      { name: t.common.home, path: '/' },
      { name: t.common.nav.education, path },
    ]),
  ]}
>
  <PageHero
    locale={locale}
    kicker={e.hero.kicker}
    title={e.hero.h1}
    lede={e.hero.lede}
    crumb={{ name: t.common.nav.education, path }}
  />

  <section class="page py-16 lg:py-24">
    <SectionHead kicker={e.method.kicker} title={e.method.h2} lede={e.method.lede} />
    <ol class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {e.method.steps.map((step, i) => (
        <li class={`reveal card p-6 ${i ? `d${i}` : ''}`}>
          <span class="t-deva text-3xl text-kesari" aria-hidden="true">
            {['१', '२', '३', '४'][i]}
          </span>
          <h3 class="t-h3 mt-3 text-ink">{step.title}</h3>
          <p class="mt-3 text-ink-2">{step.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="bg-paper-2 py-16 lg:py-24">
    <div class="page">
      <SectionHead kicker={e.strands.kicker} title={e.strands.h2} />
      <div class="mt-12 space-y-6">
        {e.strands.items.map((item, i) => (
          <article class="reveal grid gap-6 rounded-md border border-line bg-paper p-6 md:grid-cols-[auto_1fr] md:gap-10 md:p-10">
            <div class="flex items-start gap-4 md:w-56 md:flex-col">
              <span class="grid h-14 w-14 shrink-0 place-items-center rounded-sm bg-paper-2 text-kesari">
                <Icon name={icons[i]} size={28} />
              </span>
              <p class="t-deva text-xl text-kesari-deep" lang="sa">
                {item.deva}
              </p>
            </div>
            <div>
              <h3 class="t-h2 text-ink">{item.title}</h3>
              <p class="t-lede mt-4 text-ink-2">{item.body}</p>
              <ul class="mt-6 grid gap-2 sm:grid-cols-3">
                {item.points.map((point) => (
                  <li class="flex gap-3 border-l-2 border-paper-3 pl-3 text-ink-2">{point}</li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="page py-16 lg:py-24">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.6fr] lg:gap-16">
      <SectionHead kicker={e.leaves.kicker} title={e.leaves.h2} />
      <div class="reveal d1">
        <p class="t-lede text-ink-2">{e.leaves.body}</p>
        <p class="mt-6 border-l-2 border-kesari pl-4 text-ink-2">{e.leaves.note}</p>
        <a
          href={localePath(locale, '/visit/#contact')}
          class="nl mt-6 inline-flex items-center gap-2 text-kesari-deep"
        >
          {t.common.contact.write}
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </div>
  </section>

  <Shloka
    deva={t.home.shanti.deva}
    iast={t.home.shanti.iast}
    translation={t.home.shanti.translation}
    note={t.home.shanti.note}
    tone="paper-2"
    om
  />
</BaseLayout>
