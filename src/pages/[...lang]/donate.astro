---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { localeStaticPaths, localePath, type Locale } from '@/i18n';
import { getMessages } from '@/i18n/messages';
import { breadcrumbJsonLd, donateActionJsonLd, faqJsonLd, webPageJsonLd } from '@/lib/seo';
import { faqFor } from '@/lib/pages';
import { site } from '@/data/site';
import PageHero from '@/components/PageHero.astro';
import SectionHead from '@/components/SectionHead.astro';
import GivePanel from '@/components/GivePanel.astro';
import Letter from '@/components/Letter.astro';
import Faq from '@/components/Faq.astro';
import Shloka from '@/components/Shloka.astro';
import LampArt from '@/components/art/LampArt.astro';
import Icon from '@/components/Icon.astro';

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = Astro.props.locale as Locale;
const t = getMessages(locale);
const d = t.donate;
const siteUrl = Astro.site!;
const path = '/donate/';
const faq = await faqFor('donate', locale);
const whatsappHref = site.contact.whatsapp
  ? `https://wa.me/${site.contact.whatsapp}?text=${encodeURIComponent(t.common.whatsapp.text)}`
  : '';
const icons = ['leaf', 'lamp', 'sun', 'book'] as const;
---

<BaseLayout
  locale={locale}
  title={d.meta.title}
  description={d.meta.description}
  path={path}
  ogImage="/og/donate.png"
  current="donate"
  jsonLd={[
    webPageJsonLd(siteUrl, locale, { path, title: d.meta.title, description: d.meta.description }),
    breadcrumbJsonLd(siteUrl, locale, [
      { name: t.common.home, path: '/' },
      { name: t.common.nav.donate, path },
    ]),
    donateActionJsonLd(siteUrl, locale, d.hero.cta1),
    faqJsonLd(faq.plain),
  ]}
>
  <PageHero
    locale={locale}
    kicker={d.hero.kicker}
    title={d.hero.h1}
    lede={d.hero.lede}
    crumb={{ name: t.common.nav.donate, path }}
    withAside
  >
    <Fragment slot="actions">
      <div class="flex flex-wrap gap-3">
        <a href="#give" class="btn btn-primary">
          {d.hero.cta1}
        </a>
        <a href="#letter" class="btn btn-ghost">
          {d.hero.cta2}
          <Icon name="arrow-down" size={18} />
        </a>
      </div>
      <p class="t-small mt-5 text-ink-2">{d.hero.trust}</p>
    </Fragment>
    <div
      slot="aside"
      class="frame mx-auto aspect-[4/5] w-full max-w-sm border border-line lg:max-w-none"
    >
      <LampArt title={d.hero.artAlt} />
    </div>
  </PageHero>

  <section id="give" class="night-bg scroll-mt-24 py-16 lg:py-24">
    <div class="page">
      <SectionHead kicker={d.how.kicker} title={d.how.h2} lede={d.how.lede} tone="night" />
      <div class="mt-12">
        <GivePanel locale={locale} large />
      </div>
      <ol class="mt-12 grid gap-6 md:grid-cols-3">
        {d.steps.map((step, i) => (
          <li class={`reveal flex gap-4 ${i ? `d${i}` : ''}`}>
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full border border-line-night-strong font-ui text-sm font-semibold text-amber">
              {i + 1}
            </span>
            <div>
              <h3 class="t-h3 text-paper">{step.title}</h3>
              <p class="mt-1 text-paper/80">{step.body}</p>
              {i === 1 && whatsappHref && (
                <a
                  href={whatsappHref}
                  class="nl mt-2 inline-flex items-center gap-2 text-amber"
                  rel="noopener"
                >
                  <Icon name="whatsapp" size={16} />
                  {t.common.whatsapp.label}
                </a>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Letter locale={locale} />

  <section class="bg-paper-2 py-16 lg:py-24">
    <div class="page">
      <SectionHead kicker={d.becomes.kicker} title={d.becomes.h2} lede={d.becomes.lede} />
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {d.becomes.items.map((item, i) => (
          <article class={`reveal card lift p-6 ${i ? `d${i}` : ''}`}>
            <span class="text-kesari">
              <Icon name={icons[i]} size={28} />
            </span>
            <h3 class="t-h3 mt-4 text-ink">{item.title}</h3>
            <p class="mt-3 text-ink-2">{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="page py-16 lg:py-24">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.6fr] lg:gap-16">
      <div class="reveal lg:sticky lg:top-28 lg:self-start">
        <p class="t-eyebrow text-kesari-deep">{d.faq.kicker}</p>
        <h2 class="t-h2 mt-3 text-ink">{d.faq.h2}</h2>
        <p class="t-lede mt-4 text-ink-2">{d.faq.lede}</p>
        <a
          href={localePath(locale, '/visit/#contact')}
          class="nl mt-4 inline-flex items-center gap-2 text-kesari-deep"
        >
          {t.common.contact.write}
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
      <Faq locale={locale} items={faq.entries} />
    </div>
  </section>

  <Shloka
    deva={d.closing.deva}
    iast={d.closing.iast}
    translation={d.closing.translation}
    tone="night"
    om
  />
  <div class="night-bg -mt-px pb-16 text-center">
    <a href="#give" class="btn btn-paper">
      {d.closing.cta}
    </a>
  </div>
</BaseLayout>
